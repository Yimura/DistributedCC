# Container image. Override this with a local tag when testing source builds.
DCC_IMAGE=ghcr.io/yimura/distributedcc:latest

# Server deployment. compose.server.yaml renders these into readable JSON config.
DCC_DOMAIN=dcc.example.com
DCC_NODE_TOKEN_ANDRE=replace-with-random-secret
DCC_NODE_TOKEN_FRIEND=replace-with-another-random-secret

# Bridge deployment; use this laptop's matching server token.
DCC_SERVER_URL=wss://dcc.example.com
DCC_TOKEN=replace-with-random-secret
DCC_PUBLISH_SESSIONS=yrrp-release-manager
DCC_UID=1000
DCC_GID=1000
