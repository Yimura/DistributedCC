# Server deployment
DCC_DOMAIN=dcc.example.com
DCC_NODE_TOKENS={"andre":"replace-with-random-secret","friend":"replace-with-another-random-secret"}

# Bridge deployment; use one laptop-specific token from DCC_NODE_TOKENS.
DCC_SERVER_URL=wss://dcc.example.com
DCC_TOKEN=replace-with-random-secret
DCC_PUBLISH_SESSIONS=yrrp-release-manager
DCC_UID=1000
DCC_GID=1000
